{
  "name": "@mirafive/sdk-convex",
  "version": "1.0.0",
  "description": "MIRA FIVE SDK for Convex",
  "keywords": [
    "analytics",
    "convex",
    "gdpr",
    "mirafive",
    "privacy",
    "server"
  ],
  "homepage": "https://mirafive.io",
  "bugs": {
    "email": "support@mirafive.io"
  },
  "license": "MIT",
  "author": "MIRA FIVE <support@mirafive.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirafive/sdk-convex.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "size": "size-limit",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && publint --strict && attw --pack --profile esm-only && size-limit",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@mirafive/sdk-server": "^1.0.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^26.6.5",
    "convex": "^1.48.0",
    "convex-test": "^0.0.65",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsdown": "0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@mirafive/sdk-server": "^1.0.0",
    "convex": "^1.25.0"
  },
  "size-limit": [
    {
      "name": "index",
      "path": "dist/index.js",
      "ignore": [
        "@mirafive/sdk-server",
        "convex"
      ],
      "limit": "1.73 kB",
      "gzip": true
    }
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.4"
}
